<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="@dimen/screen_padding"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingTop="@dimen/space_48"
        android:paddingBottom="@dimen/space_32">

        <ImageView
            android:id="@+id/ivLocationIcon"
            android:layout_width="116dp"
            android:layout_height="116dp"
            android:layout_marginBottom="@dimen/space_24"
            android:src="@drawable/location_icon"
            android:contentDescription="@null"/>

        <TextView
            android:id="@+id/tvLocationTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="What is your location?"
            android:textStyle="bold"
            android:textSize="29sp"
            android:textColor="#000000"
            android:layout_marginBottom="@dimen/space_12"/>

        <TextView
            android:id="@+id/tvLocationSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="We need your location to access\nrestaurants near you"
            android:textSize="14sp"
            android:textColor="#000000"
            android:gravity="center"
            android:layout_marginBottom="@dimen/space_24"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAllowLocation"
            android:layout_width="match_parent"
            android:layout_height="@dimen/control_height"
            android:text="Allow location access"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            app:cornerRadius="@dimen/radius_12"
            app:backgroundTint="@color/ed_dark_green"
            android:layout_marginBottom="@dimen/space_16"/>

        <TextView
            android:id="@+id/tvEnterLocationManually"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Enter location manually"
            android:textSize="14sp"
            android:textColor="#000000"/>

    </LinearLayout>

</ScrollView>