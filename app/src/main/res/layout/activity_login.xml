<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollSignIn"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/containerSignIn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingTop="@dimen/space_48"
        android:paddingBottom="@dimen/space_32">

        <!-- Title -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="Sign In"
            android:textSize="36sp"
            android:textStyle="bold"
            android:textColor="#1E1E1E" />

        <!-- Subtitle -->
        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_8"
            android:layout_marginBottom="@dimen/space_32"
            android:text="Welcome back! you’ve been missed"
            android:textSize="14sp"
            android:textColor="#8E8E93" />

        <!-- Email -->
        <TextView
            android:id="@+id/tvEmailLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Email"
            android:textSize="14sp"
            android:textColor="#0F172A"
            android:layout_marginBottom="@dimen/space_8" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_16"
            app:boxBackgroundMode="outline"
            app:boxCornerRadiusTopStart="@dimen/radius_12"
            app:boxCornerRadiusTopEnd="@dimen/radius_12"
            app:boxCornerRadiusBottomStart="@dimen/radius_12"
            app:boxCornerRadiusBottomEnd="@dimen/radius_12"
            app:boxStrokeColor="#CBD5E1"
            app:boxBackgroundColor="@android:color/white">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Email"
                android:inputType="textEmailAddress"
                android:paddingTop="@dimen/space_12"
                android:paddingBottom="@dimen/space_12"
                android:paddingStart="@dimen/space_12"
                android:paddingEnd="@dimen/space_12"
                android:textSize="16sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Password -->
        <TextView
            android:id="@+id/tvPasswordLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Password"
            android:textSize="14sp"
            android:textColor="#0F172A"
            android:layout_marginBottom="@dimen/space_8" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_8"
            app:boxBackgroundMode="outline"
            app:boxCornerRadiusTopStart="@dimen/radius_12"
            app:boxCornerRadiusTopEnd="@dimen/radius_12"
            app:boxCornerRadiusBottomStart="@dimen/radius_12"
            app:boxCornerRadiusBottomEnd="@dimen/radius_12"
            app:boxStrokeColor="#CBD5E1"
            app:boxBackgroundColor="@android:color/white"
            app:endIconMode="password_toggle">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Password"
                android:inputType="textPassword"
                android:paddingTop="@dimen/space_24"
                android:paddingBottom="@dimen/space_12"
                android:paddingStart="@dimen/space_12"
                android:paddingEnd="@dimen/space_12"
                android:textSize="16sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Forgot password -->
        <TextView
            android:id="@+id/tvForgotPassword"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginBottom="@dimen/space_16"
            android:text="Forgot Password?"
            android:textSize="14sp"
            android:textColor="#AEAEB2" />

        <!-- Sign in button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSignIn"
            android:layout_width="match_parent"
            android:layout_height="@dimen/control_height"
            android:text="Sign In"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:textColor="@android:color/white"
            android:layout_marginBottom="@dimen/space_24"
            app:cornerRadius="@dimen/radius_12"
            app:backgroundTint="#003631" />

        <!-- Or sign in with -->
        <TextView
            android:id="@+id/tvOrSignInWith"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="@dimen/space_16"
            android:text="Or sign In with"
            android:textSize="14sp"
            android:textColor="#AEAEB2" />

        <!-- Social icons placeholder (replace with your real icons) -->
        <LinearLayout
            android:id="@+id/socialRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:layout_marginBottom="@dimen/space_24">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGoogle"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="@dimen/space_12"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text=""
                app:cornerRadius="24dp"
                app:icon="@drawable/ic_google"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconTint="@null"
                app:iconSize="20dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFacebook"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text=""
                app:cornerRadius="24dp"
                app:icon="@drawable/ic_facebook"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconTint="@null"
                app:iconSize="27dp" />
        </LinearLayout>

        <!-- Sign up -->
        <TextView
            android:id="@+id/tvSignUp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="Don’t have an account? Sign Up"
            android:textSize="14sp"
            android:textColor="#1E1E1E" />

    </LinearLayout>
</ScrollView>